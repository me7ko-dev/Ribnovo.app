# Копирайте този файл като .env.local (за компютър) или добавете същите
# имена във Vercel → Settings → Environment Variables.
# Без Supabase ключовете приложението показва примерни данни.

# --- Supabase → Project Settings → API Keys ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# ТАЕН ключ (Secret key) — само на сървъра, никога не го показвайте
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Известия (Web Push) — генерирайте с: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:вашия-имейл@example.com

# --- Адрес на сайта (по желание; за линковете в имейлите) ---
# NEXT_PUBLIC_SITE_URL=https://ribnovo.vercel.app
